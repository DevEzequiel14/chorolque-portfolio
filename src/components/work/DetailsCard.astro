---
import type { Project } from "../../types";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="work-details-card">
  <article class="work-details-card__section">
    <h2 class="work-details-card__title">Proyecto:</h2>
    <p class="work-details-card__text">{project.company}</p>
  </article>
  <article class="work-details-card__section">
    <h2 class="work-details-card__title">Mi rol:</h2>
    <p class="work-details-card__text">{project.rol}</p>
  </article>
  <article class="work-details-card__section">
    <h2 class="work-details-card__title">Tecnologías:</h2>
    <div class="work-details-card__technologies">
      {
        project.technologies.map((tech) => (
          <span class="work-details-card__tech">{tech.trim()}</span>
        ))
      }
    </div>
  </article>
  <article class="work-details-card__section">
    <h2 class="work-details-card__title">Línea de tiempo:</h2>
    <p class="work-details-card__text">{project.timeline}</p>
  </article>
</section>
