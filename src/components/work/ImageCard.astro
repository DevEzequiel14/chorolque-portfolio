---
import { Image } from "astro:assets";
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Image
  class="image-card"
  src={project.image}
  alt={project.title}
  widths={[640, 960, 1280]}
  sizes="(max-width: 1200px) 100vw, 1200px"
  loading="lazy"
  decoding="async"
  fetchpriority="low"
/>
