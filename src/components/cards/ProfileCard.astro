---
import { Picture } from "astro:assets";
import profileImage from "../../assets/profile/profile.webp";
---

<section class="perfil-card">
  <div class="perfil-card__content">
    <Picture
      src={profileImage}
      alt="Perfil"
      class="perfil-card__image"
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[280, 400, 560, 720, 960]}
      sizes="(max-width: 485px) 120px, (max-width: 810px) 140px, (max-width: 1200px) 40vw, 280px"
      quality={82}
      pictureAttributes={{ class: "perfil-card__picture" }}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>
