---
import { Picture } from "astro:assets";
import profileImage from "../../assets/profile/profile.webp";
---

<section class="perfil-card">
  <div class="perfil-card__content">
    <Picture
      src={profileImage}
      alt="Retrato de Ezequiel Chorolque"
      class="perfil-card__image"
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[280, 400, 560, 720, 960]}
      sizes="(max-width: 640px) 130px, (max-width: 900px) 180px, 28vw"
      quality={82}
      pictureAttributes={{ class: "perfil-card__picture" }}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>
