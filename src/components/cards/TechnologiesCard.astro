---
import { stacks } from "../../data/stacks";
import { techIconRegistry } from "../icons/stack/techIconRegistry";
---

<div class="technologies-card">
  <h2 class="technologies-card__title">Tecnologías que uso</h2>

  <div class="technologies-card__groups">
    {
      Object.entries(stacks).map(([category, items]) => (
        <section
          class="technologies-card__group"
          aria-labelledby={`tech-group-${category}`}
        >
          <h3 class="technologies-card__group-label" id={`tech-group-${category}`}>
            {category}
          </h3>
          <ul class="technologies-card__track">
            {items.map(({ name, slug }) => {
              const Icon = techIconRegistry[slug];
              if (!Icon) return null;

              return (
                <li class="technologies-card__item">
                  <span class="technologies-card__icon" aria-hidden="true">
                    <Icon />
                  </span>
                  <span class="technologies-card__item-title">{name}</span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</div>
