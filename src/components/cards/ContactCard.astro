---
import { socialProfiles } from "../../data/socialProfiles";
---

<a
  class="contact-card"
  href={socialProfiles.discoveryForm}
  target="_blank"
  rel="noopener noreferrer"
>
  <h2 class="contact-card__title">¿Tenés un proyecto?</h2>
  <p class="contact-card__hint">5 minutos, sin compromiso</p>
  <span class="contact-card__cta button-icon">
    Empezar la encuesta
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right"
      aria-hidden="true"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M17 7l-10 10"></path><path d="M8 7l9 0l0 9"></path></svg
    >
  </span>
  <span class="sr-only">Se abre en una pestaña nueva</span>
</a>
