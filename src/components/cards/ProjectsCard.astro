---
import { Image } from "astro:assets";
import type { Project } from "../../types";

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
---

<div class="projects-card">
  <Image
    class="projects-card__image"
    src={project.image}
    alt={`Vista previa del proyecto ${project.title}`}
    widths={[480, 720, 960]}
    sizes="(max-width: 810px) 95vw, (max-width: 1200px) 90vw, 42vw"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "low"}
  />
  <div class="projects-card__overlay">
    <span class="projects-card__project-title">{project.title}</span>
    <svg
      class="projects-card__icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14"></path>
      <path d="M12 5l7 7-7 7"></path>
    </svg>
  </div>
</div>
