---
import type { Strength } from "../../types";

export interface Props {
  items: Strength[];
}
const { items } = Astro.props;
---

<section class="text-slider">
  <h2 class="text-slider__heading">Lo que me gusta hacer</h2>
  <div class="text-slider__viewport">
    <div class="text-slider__container" id="slider">
      {
        items.map((item) => (
          <article class="text-slider__slide">
            <h3 class="text-slider__title">{item.title}</h3>
            <p class="text-slider__description">{item.description}</p>
          </article>
        ))
      }
    </div>
    <div class="text-slider__hit" aria-hidden="true"></div>
  </div>

  <nav class="text-slider__dots" aria-label="Selector de diapositivas">
    {
      items.map((_, index) => (
        <button
          type="button"
          class={`text-slider__dot ${index === 0 ? "active" : ""}`}
          data-index={index}
          aria-label={`Ir a slide ${index + 1}`}
          aria-current={index === 0 ? "true" : "false"}
        />
      ))
    }
  </nav>
</section>

<script is:inline>
  const textSliderScriptEl = document.currentScript;
  const sliderSection = textSliderScriptEl?.previousElementSibling;

  if (
    sliderSection &&
    sliderSection.classList.contains("text-slider") &&
    sliderSection.dataset.initialized !== "true"
  ) {
    sliderSection.dataset.initialized = "true";

    const slider = sliderSection.querySelector(".text-slider__container");
    const swipeSurface =
      sliderSection.querySelector(".text-slider__viewport") || sliderSection;
    const dots = sliderSection.querySelectorAll(".text-slider__dot");
    const controller = new AbortController();
    const { signal } = controller;

    if (slider && dots.length > 0) {
      let currentIndex = 0;

      function goToSlide(index) {
        currentIndex = index;
        slider.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) => {
          const isActive = i === index;
          dot.classList.toggle("active", isActive);
          dot.setAttribute("aria-current", isActive ? "true" : "false");
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener(
          "click",
          () => {
            const nextIndex = Number.parseInt(dot.dataset.index || "", 10);
            if (!Number.isNaN(nextIndex)) {
              goToSlide(nextIndex);
            }
          },
          { signal },
        );

        dot.addEventListener(
          "keydown",
          (event) => {
            const { key } = event;
            if (!["ArrowRight", "ArrowLeft", "Home", "End"].includes(key)) {
              return;
            }

            event.preventDefault();

            let nextIndex = currentIndex;
            if (key === "ArrowRight") {
              nextIndex = (currentIndex + 1) % dots.length;
            } else if (key === "ArrowLeft") {
              nextIndex = (currentIndex - 1 + dots.length) % dots.length;
            } else if (key === "Home") {
              nextIndex = 0;
            } else if (key === "End") {
              nextIndex = dots.length - 1;
            }

            goToSlide(nextIndex);
            dots[nextIndex].focus();
          },
          { signal },
        );
      });

      let startX = 0;
      let startY = 0;
      let isTracking = false;
      let axis = null;

      function resetSwipe() {
        isTracking = false;
        axis = null;
      }

      function onSwipeEnd(clientX) {
        if (!isTracking || axis !== "x") {
          resetSwipe();
          return;
        }

        const diff = clientX - startX;
        resetSwipe();

        if (Math.abs(diff) < 50) return;

        if (diff < 0) {
          goToSlide((currentIndex + 1) % dots.length);
        } else {
          goToSlide((currentIndex - 1 + dots.length) % dots.length);
        }
      }

      swipeSurface.addEventListener(
        "touchstart",
        (event) => {
          startX = event.touches[0].clientX;
          startY = event.touches[0].clientY;
          isTracking = true;
          axis = null;
        },
        { passive: true, signal },
      );

      swipeSurface.addEventListener(
        "touchmove",
        (event) => {
          if (!isTracking || axis) return;

          const dx = event.touches[0].clientX - startX;
          const dy = event.touches[0].clientY - startY;
          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;

          axis = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
        },
        { passive: true, signal },
      );

      swipeSurface.addEventListener(
        "touchend",
        (event) => {
          onSwipeEnd(event.changedTouches[0].clientX);
        },
        { passive: true, signal },
      );

      swipeSurface.addEventListener(
        "touchcancel",
        () => {
          resetSwipe();
        },
        { passive: true, signal },
      );
    }

    window.addEventListener(
      "pagehide",
      () => {
        controller.abort();
        delete sliderSection.dataset.initialized;
      },
      { once: true },
    );
  }
</script>
