---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CarouselImage {
  src: ImageMetadata;
  alt: string;
}

export interface Props {
  images: CarouselImage[];
  label?: string;
}

const { images, label = "Fotos de pasatiempos" } = Astro.props;
---

<div
  class="carousel"
  role="region"
  aria-roledescription="carrusel"
  aria-label={label}
>
  <div class="carousel__track" id="carousel-track">
    {
      images.map((image, index) => (
        <div
          class="carousel__item"
          aria-hidden={index === 0 ? "false" : "true"}
          data-slide-index={index}
        >
          <Image
            class="carousel__image"
            src={image.src}
            alt={image.alt}
            widths={[400, 600, 800, 1000]}
            sizes="(max-width: 800px) 100vw, (max-width: 1200px) 40vw, 300px"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={index === 0 ? "high" : "low"}
          />
        </div>
      ))
    }
  </div>

  <button
    class="carousel__button carousel__button--prev"
    id="prev-btn"
    aria-label="Anterior"
    type="button"
    title="Anterior"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left"
      aria-hidden="true"
      focusable="false"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M15 6l-6 6l6 6"></path></svg
    >
  </button>
  <button
    class="carousel__button carousel__button--next"
    id="next-btn"
    aria-label="Siguiente"
    type="button"
    title="Siguiente"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"
      aria-hidden="true"
      focusable="false"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M9 6l6 6l-6 6"></path></svg
    >
  </button>
</div>

<script is:inline>
  const carouselScriptEl = document.currentScript;
  const carouselRoot = carouselScriptEl?.previousElementSibling;

  if (
    carouselRoot &&
    carouselRoot.classList.contains("carousel") &&
    carouselRoot.dataset.initialized !== "true"
  ) {
    carouselRoot.dataset.initialized = "true";

    let currentIndex = 0;
    const track = carouselRoot.querySelector(".carousel__track");
    const items = track ? Array.from(track.children) : [];
    const total = items.length;
    const prevBtn = carouselRoot.querySelector(".carousel__button--prev");
    const nextBtn = carouselRoot.querySelector(".carousel__button--next");
    const controller = new AbortController();
    const { signal } = controller;

    function updateCarousel() {
      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      items.forEach((item, index) => {
        item.setAttribute(
          "aria-hidden",
          index === currentIndex ? "false" : "true",
        );
      });
    }

    prevBtn?.addEventListener(
      "click",
      () => {
        if (total <= 0) return;
        currentIndex = (currentIndex - 1 + total) % total;
        updateCarousel();
      },
      { signal },
    );

    nextBtn?.addEventListener(
      "click",
      () => {
        if (total <= 0) return;
        currentIndex = (currentIndex + 1) % total;
        updateCarousel();
      },
      { signal },
    );

    updateCarousel();

    window.addEventListener(
      "pagehide",
      () => {
        controller.abort();
        delete carouselRoot.dataset.initialized;
      },
      { once: true },
    );
  }
</script>
