---
import "@fontsource/merriweather/latin-400.css";
import "@fontsource/merriweather/latin-ext-400.css";
import "@fontsource/merriweather/latin-700.css";
import "@fontsource/merriweather/latin-ext-700.css";
import "../../styles/main.scss";
import GoogleAnalytics from "../analytics/GoogleAnalytics.astro";
import { information } from "../../data/profileInfo";
import { sameAsProfiles } from "../../data/socialProfiles";

const {
  title = "Ezequiel Chorolque",
  description = "Portafolio profesional de Ezequiel Chorolque, desarrollador frontend especializado en Angular, Astro y tecnologías modernas. Conocé sus proyectos, experiencia y habilidades.",
  keywords = "Ezequiel Chorolque, desarrollador web, Angular, Astro, frontend, programación, portfolio, tecnologías web",
  path = "/",
  ogType = "website",
  ogImage = "/og-image.webp",
} = Astro.props;

const site = Astro.site ?? new URL(import.meta.env.SITE);
const siteUrl = site.toString().replace(/\/$/, "");
const normalizedPath = path.startsWith("/") ? path : `/${path}`;
const canonicalUrl = new URL(normalizedPath, site).toString();
const ogImageUrl = new URL(ogImage, site).toString();
const personName = "Ezequiel Chorolque";
const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: personName,
      url: `${siteUrl}/`,
      email: information.email,
      jobTitle: "Desarrollador Frontend",
      sameAs: [...sameAsProfiles],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: personName,
      url: `${siteUrl}/`,
      description,
      inLanguage: "es-AR",
      publisher: { "@id": personId },
    },
  ],
};

const jsonLd = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/laptop.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Ezequiel Chorolque" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Ezequiel Chorolque" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <script is:inline>
      (function () {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {
          // Ignore storage access failures.
        }
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const themeToApply = theme || (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", themeToApply);
      })();
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <GoogleAnalytics />
  </body>
</html>
